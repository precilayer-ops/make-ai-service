# ==============================================================
# Make AI Service Configuration Template
# For PIPL: copy to .env.pipl
# For NDCS: copy to .env.ndcs
# ==============================================================

# Server
PORT=4006
HOST=0.0.0.0
INSTANCE_NAME=PIPL
ENVIRONMENT=development
LOG_LEVEL=info

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro

# AWS S3 (Read-Only)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
S3_QUOTATION_BUCKET=pipl-quotation-files
S3_QUAOAR_BUCKET=pipl-quaoar-output

# Database URIs (Read-Only on ERP, SC, & MES, Read-Write on AI Chat Store)
ERP_MONGO_URI=mongodb://localhost:27017/pipl_erp?readPreference=secondaryPreferred
SC_MONGO_URI=mongodb://localhost:27017/pipl_sc?readPreference=secondaryPreferred
MES_MONGO_URI=mongodb://localhost:27017/pipl_mes?readPreference=secondaryPreferred
AI_CHAT_MONGO_URI=mongodb://localhost:27017/pipl_ai_service

# Quaoar CAD Microservice URL
QUAOAR_URL=http://localhost:4004
